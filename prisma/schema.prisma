// Prisma schema for MongoDB
// Datasource & generator

generator client {
  provider = "prisma-client-js"
  output   = "prisma/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Models
model User {
  id          String       @id @default(uuid()) @map("_id")
  email       String       @unique
  phone       String?      @unique
  firstName   String
  lastName    String
  password    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  roles       String[]     @default([])
  invitations Invitation[]
}

/// Invitation (event) hosted by a User and having many Guests
model Invitation {
  id            String               @id @default(uuid()) @map("_id")
  hostId        String
  host          User                 @relation(fields: [hostId], references: [id])
  type          EventType            @default(MARRIAGE)
  title         String
  hostManName   String?
  hostWomanName String?
  description   String?
  location      String?
  coordinate    String[] // optional semantics handled by empty array
  images        String[]
  slug          String               @unique
  startsAt      DateTime
  endsAt        DateTime?
  theme         String?
  visibility    InvitationVisibility @default(PRIVATE)
  status        InvitationStatus     @default(DRAFT)
  price         Float?
  currency      String?              @default("USD")
  
  // Relations to services
  venueId       String?
  venue         Venue?               @relation(fields: [venueId], references: [id])
  cateringId    String?
  catering      Provider?            @relation("Catering", fields: [cateringId], references: [id])
  securityId    String?
  security      Provider?            @relation("Security", fields: [securityId], references: [id])

  guests        Guest[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([hostId])
  @@index([status])
  @@index([visibility])
  @@index([type])
}

model Venue {
  id          String       @id @default(uuid()) @map("_id")
  name        String
  address     String
  capacity    Int?
  price       Float?
  images      String[]
  invitations Invitation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum ProviderType {
  CATERING
  SECURITY
}

model Provider {
  id                  String       @id @default(uuid()) @map("_id")
  name                String
  type                ProviderType
  description         String?
  price               Float?
  rating              Float?
  cateringInvitations Invitation[] @relation("Catering")
  securityInvitations Invitation[] @relation("Security")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

/// Guest invited to an Invitation
model Guest {
  id           String      @id @default(uuid()) @map("_id")
  invitationId String
  invitation   Invitation  @relation(fields: [invitationId], references: [id])
  name         String
  email        String?
  phone        String?
  slug         String      @unique
  status       String
  token        String      @unique
  place        String?
  respondedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([invitationId, phone])
  @@index([status])
}

// Enums reflecting domain state machines
enum InvitationVisibility {
  PRIVATE
  PUBLIC
}

enum InvitationStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum EventType {
  MARRIAGE
  DOT
  ANNIVERSARY
  CONFERENCE
  MEETING
  OTHER
}
